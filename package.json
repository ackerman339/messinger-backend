{
  "name": "messinger-backend",
  "version": "1.0.0",
  "description": "Real time communications",
  "author": "levi ackerman",
  "license": "MIT",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "cli": "tsx scripts/cli/index.ts",
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/server.ts'",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "node dist/src/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/src/server.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "seed": "tsx src/scripts/seeds.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage logs/*.log",
    "validate": "pnpm lint && pnpm format:check && pnpm type-check",
    "prebuild": "pnpm clean",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:unit": "cross-env NODE_ENV=test vitest run tests/unit",
    "test:integration": "cross-env NODE_ENV=test vitest run tests/integration",
    "test:e2e": "cross-env NODE_ENV=test vitest run tests/e2e",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"scripts/**/*.ts\" \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"scripts/**/*.ts\" \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "bcrypt": "6.0.0",
    "bullmq": "5.80.6",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.6.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.0",
    "uuid": "14.0.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "ws": "8.21.1",
    "yargs": "18.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@faker-js/faker": "10.5.0",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitest/coverage-v8": "4.1.10",
    "commitlint": "21.2.1",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unicorn": "65.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "nodemon": "3.1.14",
    "openapi-types": "12.1.3",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "glob": "13.0.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
